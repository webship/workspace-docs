{
  "name": "@webship.co/workspace-docs",
  "version": "1.0.12",
  "description": "The Docs workspace for Webship Workspace: the `docs/` folder (type files), its settings file, its 2 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-docs.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "docs",
    "label": "Docs",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "workspace": {
      "key": "docs",
      "settingsTemplate": "config/workspace.docs.settings.yml",
      "files": [
        "commands/cmd-tool-backup-doc.sh",
        "commands/cmd-tool-git-change-filemode-to-false.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/docs-writer.md"
      ],
      "skills": [
        "ai/skills/docs-workflow"
      ],
      "commands": [
        "ai/commands/docs-write.md"
      ],
      "prompts": [
        "ai/prompts/docs-write-a-document.md"
      ]
    },
    "features": [
      "features/docs.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
